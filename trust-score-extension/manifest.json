{
    "manifest_version": 3,
    "name": "URL Trust Scorer",
    "version": "0.2",
    "description": "Runs multi-signal URL threat scans using the local URL Trust Scorer API.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "URL Trust Scorer"
    },
    "permissions": [
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
    ]
}
